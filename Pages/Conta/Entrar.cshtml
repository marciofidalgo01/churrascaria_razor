@page
@model Churrascaria.Pages.Conta.EntrarModel
@{ ViewData["Title"] = "Área da equipe"; }
<section class="section container login-container">
    <a class="back-link" asp-page="/Index">← Voltar ao site</a>
    <div class="login-card"><p class="eyebrow">ÁREA DA EQUIPE</p><h1>Bem-vindo de volta.</h1><p>Entre para acompanhar as solicitações de eventos.</p>
        <form method="post" class="booking-form">
            <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
            <div class="field"><label asp-for="Usuario">Usuário</label><input asp-for="Usuario" autocomplete="username" required /><span asp-validation-for="Usuario"></span></div>
            <div class="field"><label asp-for="Senha">Senha</label><input asp-for="Senha" type="password" autocomplete="current-password" required /><span asp-validation-for="Senha"></span></div>
            <button type="submit" class="button button-primary">Entrar <span aria-hidden="true">↗</span></button>
        </form>
    </div>
</section>
