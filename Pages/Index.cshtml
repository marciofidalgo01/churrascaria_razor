            Categoria = "Qualidade e tradição",
            Descricao = "Preparo artesanal das carnes na brasa",
            Imagens = new[] {
                "https://images.unsplash.com/photo-1529193591184-b1d58069ecdd",
                "https://images.unsplash.com/photo-1555939594-58d7cb561ad1"
            }
        },
        new {
            Titulo = "Cortes especiais",
            Categoria = "Seleção de carnes",
