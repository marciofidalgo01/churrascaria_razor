@page
@model Churrascaria.Pages.IndexModel
@{ ViewData["Title"] = "Churrasco para o seu evento"; }

<section class="hero" id="inicio">
    <div class="container hero-grid">
        <div class="hero-content">
            <p class="eyebrow"><span class="small-rule"></span></p>
            <h1>O churrasco<br />é com a gente.<br /><em>A festa é sua.</em></h1>
            <p class="hero-description">Churrasqueiro e equipe para seu aniversário, casamento ou confraternização. Um serviço combinado com você, para aproveitar cada momento com seus convidados.</p>
            <div class="button-group">
                <a class="button button-primary" asp-page="/Agendamento/Novo">Planejar meu evento <span aria-hidden="true">↗</span></a>
                <a class="text-link" href="#sobre">Conhecer o serviço <span aria-hidden="true">↓</span></a>
            </div>
            <div class="hero-footnote"><span class="status-dot" aria-hidden="true"></span> Atendimento no local do seu evento</div>
        </div>
        <figure class="hero-visual">
            @if (!string.IsNullOrWhiteSpace(Model.Empresa.FotoPrincipal))
            {
                <img class="hero-photo" src="@Url.Content(Model.Empresa.FotoPrincipal)" alt="@Model.Empresa.FotoPrincipalAlt" width="640" height="760" fetchpriority="high" />
            }
            else
            {
                <div class="brand-art" aria-label="Identidade visual Mestre da Brasa">
                    <span class="art-top">FESTA BOA TEM CHURRASCO</span>
                    <div class="art-circle"><img src="~/images/fire.png" alt="" width="190" height="230" /></div>
                    <p>Gente reunida.<br /><em>Brasa acesa.</em></p>
                    <span class="art-bottom">MESTRE DA BRASA</span>
                </div>
            }
            <figcaption class="hero-caption"><span class="caption-number">01 /</span><span>Da preparação ao último corte,<br /><strong>cuidado em cada detalhe.</strong></span></figcaption>
        </figure>
    </div>
</section>

<div class="occasion-strip"><div class="container"><span>Aniversários</span><span aria-hidden="true">✦</span><span>Casamentos</span><span aria-hidden="true">✦</span><span>Confraternizações</span><span aria-hidden="true">✦</span><span>Eventos corporativos</span></div></div>

<section class="section container about-grid" id="sobre">
    <div><p class="eyebrow">NOSSO SERVIÇO</p><h2>Menos preocupação.<br /><em>Mais tempo à mesa.</em></h2></div>
    <div class="about-copy"><p>Um churrasco bem preparado começa com uma boa conversa. Você conta como imagina seu evento, e a gente combina o cardápio, o serviço e o que será necessário no local.</p><p>Com uma equipe pequena e atendimento próximo, cuidamos do preparo para você estar onde importa: junto dos seus convidados.</p><a class="text-link dark-link" asp-page="/Agendamento/Novo">Conte sua ideia <span aria-hidden="true">↗</span></a></div>
</section>

<section class="events-section" id="eventos"><div class="container section">
    <div class="section-heading"><div><h2>Qual é a ocasião?</h2></div><p>Do encontro em família à comemoração especial, o serviço é planejado de acordo com cada evento.</p></div>
    <div class="event-grid">
        <article class="event-card"><span class="event-number">___</span><h3>Festas & aniversários</h3><p>Uma boa conversa, gente querida e churrasco para celebrar juntos.</p><a asp-page="/Agendamento/Novo" class="card-link">Planejar a festa <span aria-hidden="true">↗</span></a></article>
        <article class="event-card"><span class="event-number">___</span><h3>Casamentos</h3><p>Um cardápio e um serviço combinados para fazer parte desse dia.</p><a asp-page="/Agendamento/Novo" class="card-link">Conversar sobre o dia <span aria-hidden="true">↗</span></a></article>
        <article class="event-card"><span class="event-number">___</span><h3>Confraternizações</h3><p>Para reunir amigos, família ou a equipe da empresa em volta da mesa.</p><a asp-page="/Agendamento/Novo" class="card-link">Organizar o encontro <span aria-hidden="true">↗</span></a></article>
    </div>
</div></section>



@{
    var portfolio = new[]
    {
        new {
            Titulo = "Churrasco completo",
            Categoria = "Eventos e confraternizações",
            Descricao = "Churrasco completo para eventos e confraternizações",
